# ============================================================================
# CONVOY — ADMIN (Laptop A / Mac) environment template
# Copy to .env and fill in.  .env is gitignored and NEVER committed.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------- identity --
# local | staging | prod
CONVOY_ENV=local
LOG_LEVEL=INFO

# -------------------------------------------------------------- MQTT broker -
# From HiveMQ Cloud console → Cluster → Overview / Access Management.
# The ADMIN uses its own dedicated credential, separate from every device.
MQTT_HOST=xxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud
# 8883 = MQTT/TLS. Use 8884 for WSS fallback.
MQTT_PORT=8883
# tcp | websockets
MQTT_TRANSPORT=tcp
MQTT_TLS=true
MQTT_USERNAME=convoy_server
MQTT_PASSWORD=CHANGE_ME
MQTT_CLIENT_ID=convoy-bridge-1
MQTT_TOPIC_ROOT=convoy/v1
# MQTT5 shared subscription group
MQTT_SHARED_GROUP=convoy-bridge

# ------------------------------------------------------------------ database -
# Local Docker Postgres by default. Swap to a Neon/Supabase URL for cloud.
POSTGRES_USER=convoy
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=convoy
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://convoy:CHANGE_ME@localhost:5432/convoy

# --------------------------------------------------------------------- redis -
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------------- crypto -
# Generated by tools/keygen.py. The PRIVATE key exists ONLY on this machine.
# Devices are shipped the PUBLIC key only.
FIRMWARE_SIGNING_PRIVATE_KEY_PATH=./secrets/convoy_ed25519_private.pem
FIRMWARE_SIGNING_PUBLIC_KEY_PATH=./secrets/convoy_ed25519_public.pem
# Optional payload confidentiality layer (AES-256-GCM). Leave false for v1.
FIRMWARE_ENCRYPTION_ENABLED=true

# ------------------------------------------------------------------ API/auth -
API_HOST=0.0.0.0
API_PORT=8000
# required by every mutating endpoint
ADMIN_API_TOKEN=CHANGE_ME
# 32+ random chars, `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------- rollout defaults ----
# Campaign-level values override these; these are only the form defaults.
DEFAULT_BATCH_SIZE=5
DEFAULT_BATCH_SIZE_MIN=1
DEFAULT_BATCH_SIZE_MAX=20
DEFAULT_CANARY_SIZE=2
DEFAULT_MIN_BATTERY=30
DEFAULT_MIN_NETWORK_QUALITY=2
SHRINK_THRESHOLD=0.20
ABORT_THRESHOLD=0.40
GROW_AFTER_CLEAN_BATCHES=2
EWMA_ALPHA=0.5
CHUNK_SIZE_BYTES=8192
CHUNK_WINDOW=8
DEVICE_OFFLINE_TTL_SECONDS=20
BATCH_TIMEOUT_SECONDS=180
MAX_ATTEMPTS_PER_DEVICE=3

# ----------------------------------------------------------------- storage ---
FIRMWARE_STORAGE_DIR=./storage/firmware