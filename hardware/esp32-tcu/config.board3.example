// ===========================================================================
// CONVOY — config.h for BOARD 3  (esp32_003)
//
// Copy this to config.h in hardware/esp32-tcu/ on Sumit's laptop, then fill in
// the four secrets marked CHANGE_ME by copying them from Shashank's config.h.
// This file is gitignored: it holds WiFi and broker credentials.
//
// THIS BOARD IS THE ONE THAT REFUSES.
//
// esp32_003 sits at 8% battery, so it declines every update it is offered and
// reports FAILED_LOW_BATTERY. It is the physical counterpart of tcu_D_004 in
// the simulated fleet, and it exists so that the eligibility gate and the
// adaptive engine have something real to react to on stage.
//
// It is not broken. Nothing about it needs fixing before the demonstration —
// its refusal IS the demonstration. A device that declines an update it cannot
// safely complete is the system working, and the OLED will show REFUSED with
// the reason while the rest of the fleet carries on.
// ===========================================================================
#pragma once

// ---------------------------------------------------------------- identity --
#define DEVICE_ID        "esp32_003"
#define FLEET_TAG        "table"
#define DEVICE_MODEL     "esp32-tcu-v1"
#define INITIAL_VERSION  "3.1.0"

// 8% battery. Any campaign with a min_battery above this refuses at the offer,
// before a single chunk is transferred — the check happens on the device, from
// its own reading, not on the server's stale copy of it.
#define BATTERY_PERCENT  8
#define NETWORK_QUALITY  5

// ------------------------------------------------------------------- WiFi --
#define WIFI_SSID        "CHANGE_ME"
#define WIFI_PASSWORD    "CHANGE_ME"

// ----------------------------------------------------------------- broker --
#define MQTT_HOST        "b8ec2aadc24f4720a99bfd631ca7872c.s1.eu.hivemq.cloud"
#define MQTT_PORT        8883
#define MQTT_USERNAME    "convoy_esp32"
#define MQTT_PASSWORD    "CHANGE_ME"
#define MQTT_TOPIC_ROOT  "convoy/v1"

// ----------------------------------------------------------------- crypto --
// The server's Ed25519 PUBLIC key. Safe to commit: it can verify signatures
// but never create them.
#define SERVER_PUBLIC_KEY_HEX "a2c681ca1c7cb79a21a399acc5cd408369437d229dbd160e5eabe7d4d2680c30"

// Paste the same certificate the other two boards use — generate it with
// `python tools/broker_ca.py` on the Mac, or copy it verbatim from Shashank's
// config.h.
static const char* BROKER_ROOT_CA = R"EOF(
-----BEGIN CERTIFICATE-----
PASTE THE SAME ROOT CERTIFICATE AS THE OTHER BOARDS
-----END CERTIFICATE-----
)EOF";

// ------------------------------------------------------------------- pins --
#define PIN_LED_GREEN 25   // idle / verified
#define PIN_LED_BLUE  26   // offered / downloading / installing
#define PIN_LED_RED   27   // failed
#define PIN_I2C_SDA   21
#define PIN_I2C_SCL   22

// ------------------------------------------------------------ OLED driver --
// Uncomment for a 1.3" SH1106 panel; leave commented for a 0.96" SSD1306.
// The boot log prints an I2C scan and says which driver it used, so if the
// screen shows speckle rather than text, toggle this and re-upload.
//
// Requires the "Adafruit SH110X" library.
//
// #define OLED_SH1106

#define HEARTBEAT_MS  5000
