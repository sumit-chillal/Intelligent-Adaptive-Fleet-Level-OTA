// ===========================================================================
// CONVOY — per-board configuration.
//
// Copy this file to config.h and fill it in FOR EACH BOARD. config.h is
// gitignored: it holds WiFi and broker credentials.
//
//   cp config.h.example config.h
//
// Every board needs a DIFFERENT DEVICE_ID. Two boards sharing an id would
// fight over the same MQTT client identity and disconnect each other in a
// loop, which looks exactly like a flaky network and is miserable to debug.
// ===========================================================================
#pragma once

// ---------------------------------------------------------------- identity --
// esp32_001 and esp32_002 are healthy. esp32_003 is the low-battery unit that
// refuses updates on stage — set BATTERY_PERCENT to 8 on that board only.
#define DEVICE_ID        "esp32_001"
#define FLEET_TAG        "table"
#define DEVICE_MODEL     "esp32-tcu-v1"
#define INITIAL_VERSION  "1.3.0"

// Simulated readings. A real vehicle reads these from its power management
// and modem; here they are configuration so the demo can stage a failure.
#define BATTERY_PERCENT  87
#define NETWORK_QUALITY  5

// ------------------------------------------------------------------- WiFi --
// Use a phone hotspot for the demo. It proves the board is on a network of its
// own, unrelated to any laptop's.
#define WIFI_SSID        "your-hotspot"
#define WIFI_PASSWORD    "your-password"

// ----------------------------------------------------------------- broker --
#define MQTT_HOST        "xxxxxxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT        8883
#define MQTT_USERNAME    "convoy_esp32"
#define MQTT_PASSWORD    "CHANGE_ME"
#define MQTT_TOPIC_ROOT  "convoy/v1"

// ----------------------------------------------------------------- crypto --
// The server's Ed25519 PUBLIC key, 64 hex characters. Printed by
// tools/keygen.py on the admin machine. Safe to commit: it can verify
// signatures but never create them.
#define SERVER_PUBLIC_KEY_HEX "a2c681ca1c7cb79a21a399acc5cd408369437d229dbd160e5eabe7d4d2680c30"

// Root certificate of the broker's TLS chain, in PEM form.
//
// NOT setInsecure(). A device that skips certificate validation will talk to
// anything claiming to be the broker, which discards the confidentiality half
// of the design for the sake of three lines of setup.
//
// Fetch the exact chain your cluster presents:
//   openssl s_client -showcerts -connect YOUR_HOST:8883 </dev/null
// and paste the LAST certificate in the output (the root) below.
static const char* BROKER_ROOT_CA = R"EOF(
-----BEGIN CERTIFICATE-----
PASTE THE ROOT CERTIFICATE HERE
-----END CERTIFICATE-----
)EOF";

// ------------------------------------------------------------------- pins --
#define PIN_LED_GREEN 25   // idle / verified
#define PIN_LED_BLUE  26   // offered / downloading / installing
#define PIN_LED_RED   27   // failed
#define PIN_I2C_SDA   21
#define PIN_I2C_SCL   22

#define HEARTBEAT_MS  5000
