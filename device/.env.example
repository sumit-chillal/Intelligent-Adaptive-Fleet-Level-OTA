# ============================================================================
# CONVOY - DEVICE laptop (B / C / D) environment template
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# CRITICAL FORMATTING RULES
#   `docker run --env-file` is a DUMB parser. Unlike python-dotenv it does NOT
#   strip inline comments, quotes, or trailing spaces -- everything after the
#   `=` becomes part of the value, verbatim. So:
#
#     MQTT_TRANSPORT=tcp   # some note    ->  value is 'tcp   # some note'
#     MQTT_PASSWORD="abc123"              ->  value is '"abc123"' with quotes
#     MQTT_PASSWORD=abc123                ->  value is 'abc123 ' with a space
#
#   All three produce a confusing "Not authorized" or a broken connection.
#   Therefore: NO inline comments. NO quotes. NO trailing spaces.
#   Comments live on their own line, starting at column 1.
#
# This file holds CREDENTIALS ONLY. Device identity and health profiles live in
# the compose files, because those are configuration you want readable and
# changeable per laptop -- not secrets. Never commit this file.
# ============================================================================

# Your HiveMQ cluster hostname. No https://, no trailing slash, no port.
MQTT_HOST=CHANGE_ME.s1.eu.hivemq.cloud

# 8883 for MQTT over TLS. Use 8884 with MQTT_TRANSPORT=websockets if the
# venue firewall blocks 8883.
MQTT_PORT=8883

# tcp | websockets
MQTT_TRANSPORT=tcp

MQTT_TOPIC_ROOT=convoy/v1

# Use the credential for THIS laptop:
#   Laptop B -> convoy_device_b
#   Laptop C -> convoy_device_c
#   Laptop D -> convoy_device_d
# In the demo all containers on one laptop share a credential. For production,
# issue one per device with broker ACLs scoped to its own topic branch.
MQTT_USERNAME=convoy_device_b
MQTT_PASSWORD=CHANGE_ME

# The server's Ed25519 PUBLIC key as 64 hex characters, printed by
# tools/keygen.py on the admin machine. This is a PUBLIC key: it can verify
# signatures but never create them, so it is safe to distribute and safe to
# commit. Without it a device cannot check that firmware came from the
# authorised server, so the agent refuses to start.
SERVER_PUBLIC_KEY_HEX=CHANGE_ME

LOG_LEVEL=INFO
HEARTBEAT_SECONDS=5
INITIAL_VERSION=1.3.0
